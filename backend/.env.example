# Database Configuration
# Local development example:
# DATABASE_URL=postgresql://username:password@localhost:5432/expense_intelligence
#
# Supabase session pooler is the safest default for hosted backends like Render:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase direct connection example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Configuration
DEBUG=False
CORS_ORIGIN=http://localhost:5173,https://your-production-domain.vercel.app
CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$|^https://.*\\.vercel\\.app$

# App Metadata
APP_NAME=Expense Intelligence
APP_VERSION=1.0.0
